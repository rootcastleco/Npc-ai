{
  "version": 3,
  "cmakeMinimumRequired": {"major": 3, "minor": 20, "patch": 0},
  "configurePresets": [
    {"name": "debug", "displayName": "Debug tests", "generator": "Ninja", "binaryDir": "${sourceDir}/build/debug", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}},
    {"name": "release", "displayName": "Release static library", "generator": "Ninja", "binaryDir": "${sourceDir}/build/release", "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}},
    {"name": "shared", "displayName": "Release shared C ABI", "generator": "Ninja", "binaryDir": "${sourceDir}/build/shared", "cacheVariables": {"CMAKE_BUILD_TYPE": "Release", "BUILD_SHARED_LIBS": "ON"}}
  ]
}
